<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Esqueleto minimo del microservicio de evaluacion.

    NO tiene logica de negocio a proposito. Existe para que las etapas de Java del
    gate (formato, compilacion, tests, analisis estatico, idioma) se puedan probar
    HOY, sembrando errores adrede, en vez de escribirlas a ciegas y descubrir que
    no andan el dia del primer commit real.

    El diseno del servicio esta en docs/02-arquitectura-y-stack.md.
  -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>ar.edu.utn.frc.tup.piv</groupId>
  <artifactId>ms-evaluacion-llm</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>ms-evaluacion-llm</name>
  <description>Microservicio de evaluacion LLM - Tema 07</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless.version>2.44.0</spotless.version>
    <pmd.version>3.26.0</pmd.version>
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Formato. El gate corre spotless:apply en local (te corrige los archivos)
           y spotless:check en el CI (el runner no escribe nada). -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>

      <!-- Analisis estatico: codigo muerto, variables sin usar, catch vacios.
           failOnViolation=false a proposito: quien decide si un hallazgo frena
           es checks.yml, no el plugin. El gate lee el XML de target/. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.version}</version>
        <configuration>
          <failOnViolation>false</failOnViolation>
          <printFailingErrors>true</printFailingErrors>
          <format>xml</format>
          <linkXRef>false</linkXRef>
          <!-- CPD: cuantos tokens iguales seguidos cuentan como duplicacion. El
               default de 100 solo caza copias enormes; 60 encuentra el
               copiar-pegar real sin marcar cada getter parecido. -->
          <minimumTokens>60</minimumTokens>
          <rulesets>
            <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
          </rulesets>
        </configuration>
      </plugin>

      <!-- Cobertura. El umbral NO se pone aca: un porcentaje global sobre todo
           el modulo premia testear getters y castiga testear lo dificil. El gate
           mide con diff-cover la cobertura de las lineas que agregaste en ESTE
           cambio, que es lo unico que no genera deuda retroactiva. Este plugin
           solo produce el reporte XML que diff-cover lee. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <!-- Contar esto infla el numero sin que nadie teste nada real. -->
            <exclude>**/*Application.class</exclude>
            <exclude>**/config/**</exclude>
            <exclude>**/dto/**</exclude>
            <exclude>**/entity/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>reporte</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- El gate lee los XML de surefire, asi que la suite no debe abortar
               el build antes de escribirlos. -->
          <testFailureIgnore>true</testFailureIgnore>
          <excludedGroups>integracion</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Perfil completo: lo que corre el CI. Suma los tests de integracion, que
         levantan Postgres y Redis y no entran en el presupuesto del gate local. -->
    <profile>
      <id>completo</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
