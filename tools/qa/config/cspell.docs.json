{
  "version": "0.2",
  "language": "es,en",
  "import": ["/opt/qa-node/node_modules/@cspell/dict-es-es/cspell-ext.json"],
  "dictionaryDefinitions": [
    {
      "name": "proyecto",
      "path": "./proyecto/project-words.txt",
      "addWords": true
    },
    {
      "name": "rioplatense",
      "path": "./es-rioplatense.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "proyecto",
    "rioplatense",
    "es-es",
    "en_us",
    "softwareTerms",
    "filetypes"
  ],
  "ignorePaths": ["**/node_modules/**", "**/target/**", ".git/**"],
  "ignoreRegExpList": [
    "/```[\\s\\S]*?```/g",
    "/`[^`\\n]+`/g",
    "/\\]\\([^)]*\\)/g",
    "/\\S+\\.(md|pdf|java|py|ya?ml|json|toml|sh|xml|txt)\\b/g",
    "/https?:\\/\\/\\S+/g"
  ],
  "allowCompoundWords": false
}
