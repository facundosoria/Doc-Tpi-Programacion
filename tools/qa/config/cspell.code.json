{
  "version": "0.2",
  "language": "en",
  "noConfigSearch": true,
  "dictionaryDefinitions": [
    {
      "name": "proyecto-code",
      "path": "./proyecto/code-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["proyecto-code", "en_us", "softwareTerms", "java", "filetypes"],
  "ignorePaths": ["**/target/**", "**/node_modules/**"],
  "ignoreRegExpList": [
    "/https?:\\/\\/\\S+/g",
    "/\\S+\\.(md|pdf|ya?ml|json|toml|xml|txt)\\b/g",
    "/`[^`\\n]+`/g",
    "/\\{@link [^}]*\\}/g"
  ],
  "allowCompoundWords": true
}
