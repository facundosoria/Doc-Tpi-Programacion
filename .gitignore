# Material de origen (se distribuye por la catedra)
*.pdf

# Salida del gate de calidad
.qa/

# Python del gate
__pycache__/
*.pyc

# Build de Java
target/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.iml

# Configuracion con secretos. docker compose levanta el .env que este al lado del
# compose file sin que nadie se lo pida, y el README del front muestra las lineas
# a pegar ahi --incluido CI_TOKEN--. Sin esta regla, el que las pegue commitea el
# token sin darse cuenta. La etapa `secretos` lo agarraria igual, pero un cinturon
# no es razon para no cerrar la puerta.
.env
.env.*
!.env.example
