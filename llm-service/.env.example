# Variables de entorno de llm-service.
# Copiar a .env (o setearlas como variables reales del entorno) — nunca commitear valores reales.

# Puerto HTTP interno del servicio (nunca se publica hacia afuera, ver ADR-015: solo lo alcanza
# el API Gateway vía Eureka). Par libre del proyecto: 8086 app / 8087 management.
SERVER_PORT=8086
MANAGEMENT_PORT=8087

# Conexión a PostgreSQL (esquema "llm").
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/llm
SPRING_DATASOURCE_USERNAME=llm
SPRING_DATASOURCE_PASSWORD=llm

# URL del Eureka server del proyecto integrado (gateway + discovery del Topic 01).
EUREKA_URL=http://eureka:8761/eureka/

# URL del API Gateway institucional para comunicación micro-a-micro.
GATEWAY_URL=http://api-gateway:8080

# Credenciales de cliente M2M del servicio
APP_CLIENT_ID=llm-service
APP_CLIENT_SECRET=

# =============================================================================
# PROVEEDORES DE IA — qué key sacar, dónde, y para qué se usa cada una
# Nunca commitear claves reales. En desarrollo/demo, definirlas en .env local o en el entorno del SO.
# Sin ninguna key el servicio anda igual: tutor/evaluador/embeddings usan el proveedor "fake"
# (gratis, sin red, respuestas de prueba).
# =============================================================================

# --- Groq (ADR-016 / LLM-EP02-H02) — proveedor real de PRUEBA, plan gratis -----
# Para qué: TUTOR socrático (y, si se reasigna, evaluador/generador). Es el único adaptador real hoy.
# Sacar la key gratis: https://console.groq.com/keys
# Ojo: con solo poner la key NO alcanza. El tutor arranca asignado a "fake"; para usar Groq hay que
# reasignarlo una vez (rige sin redeploy):
#   PUT /api/llm/model-assignments/tutor   {"provider":"groq","modelId":"openai/gpt-oss-20b","modelVersion":"1"}
#   (header Idempotency-Key obligatorio; para volver al fake: provider "fake", modelId "fake-socratic-v1")
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI Omni-Moderation — MODERADOR contextual del chat -------------------
# Para qué: capa contextual de moderación de mensajes (chat-service → llm-service). Las reglas propias
# (ofensivo, spam, ofuscación) corren sin key; sin ella, los mensajes dudosos quedan en PENDING_REVIEW
# (modo degradado, métrica moderation_fallback_total).
# Sacar la key: https://platform.openai.com/api-keys  (el endpoint de moderación es gratuito)
LLM_MODERATION_CONTEXTUAL_API_KEY=
LLM_MODERATION_CONTEXTUAL_URL=https://api.openai.com
LLM_MODERATION_CONTEXTUAL_MODEL=omni-moderation-latest

# --- Google Gemini (AI Studio) — proveedor DISEÑADO para tutor/generador, aún sin adaptador -----
# Para qué: los docs fijan Gemini 3.5 Flash-Lite para tutor y generador, pero todavía no hay adaptador
# en el gateway: estas variables NO las lee el servicio hoy. La key de Gemini, cuando se use, se carga
# cifrada por la API de credenciales (LLM_CREDENTIALS_MASTER_KEY), no por variable de entorno.
# Sacar la key gratis: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# Clave AES-256 (base64, 32 bytes) para cifrar credenciales de proveedores. Obligatoria en compose.
# Generar con: openssl rand -base64 32
LLM_CREDENTIALS_MASTER_KEY=

# Solo dev/tests: acepta el payload del Bearer SIN verificar firma. Mantener en false en cualquier
# despliegue alcanzable fuera del API Gateway (ver docsV2/00-gobierno-y-evolucion/adr/ADR-001-arquitectura-y-convenciones-llm-service.md, §3).
TRUST_UNSIGNED_BEARER=false

# Bus de eventos Kafka (LLM-EP01-H07). El outbox transaccional siempre escribe; el relay y los
# consumidores solo se activan con LLM_KAFKA_ENABLED=true. El bus de la plataforma es
# event-bus:29092 (KAFKA.pdf); el compose de llm-service trae un broker local "kafka-local:29092" para
# probar sin la plataforma.
KAFKA_BOOTSTRAP=event-bus:29092
LLM_KAFKA_ENABLED=false

# --- courses-service (resolución de cursos y cohortes, vía API Gateway) -------------------------
# OBLIGATORIAS fuera del perfil "workbench": sin default en application.yml, el servicio no arranca
# si faltan. Token M2M del servicio hacia el Gateway (ADR-003).
LLM_COURSES_BASE_URL=http://api-gateway:8080
LLM_COURSES_SERVICE_TOKEN=

# --- Reintentos y circuit breaker hacia los proveedores de IA (defaults en application.yml) -----
LLM_GATEWAY_MAX_ATTEMPTS=3
LLM_GATEWAY_BACKOFF_MS=200
LLM_GATEWAY_BREAKER_MIN_CALLS=5
LLM_GATEWAY_BREAKER_FAILURE_RATE=50
LLM_GATEWAY_BREAKER_OPEN_WAIT_S=30

# --- Evaluación de intentos ---------------------------------------------------------------------
LLM_EVALUATION_RUBRIC_VERSION_ID=10000000-0000-0000-0000-000000000002
LLM_EVALUATION_TIMEOUT_MS=8000
LLM_EVALUATION_RETRY_AFTER_MINUTES=30

# --- Notificaciones de moderación ---------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_MODERATION_EVENTS_PATH=/api/notifications/v1/moderation-events

# Volumen de Postgres de los perfiles mesh/server. Solo cambiarlo si el historial de Flyway del volumen
# actual no coincide con el código (evita borrar el viejo). Default: llm-service_llm-postgres-data.
# LLM_PG_VOLUME=llm-postgres-data-v2
